# =========================================================================
# Vercel Deployment Ignore Rules
# Excludes development artifacts, caches, backups, and heavy files
# =========================================================================

# Git Repository History (prevents cloning/uploading heavy packfiles)
.git/
.github/

# Local Scratch, Diagnostic & Backup Files
scratch/
image_backups/

# Python Environments, Runtimes & Caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.coverage
htmlcov/

# Local Python Server & Backend Utility Scripts (Only api/*.js runs on Vercel)
server.py
setup_backend.py
alter_schema.py
requirements.txt

# Editor & IDE settings
.vscode/
.idea/
*.swp
*.swo

# Secrets & Environment Variables (Strictly excluded from deployment upload)
.env
.env.*
.env.local
firebase-secrets.js
secrets.js

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
