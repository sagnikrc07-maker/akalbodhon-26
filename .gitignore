# =========================================================================
# Akalbodhon Git Ignore Rules
# Strictly prevents secret leakage and vulnerable file tracking
# =========================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Temporary & Diagnostic Scratch Files
.github/
.gemini/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
scratch/
*.tmp
*.temp
*.bak
*.backup

# Python Runtime, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Node & Build Outputs
node_modules/
.vercel/
.output/

# Database Files & Dumps
*.sqlite
*.sqlite3
*.db
*.db3
*.s3db
*.sql.dump

# Certificates, Keys & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_ed25519
*.token
token.json
*-adminsdk-*.json
serviceAccount*.json
*credentials*.json

# Local Secrets & Environment Variables (Strictly Private)
firebase-secrets.js
firebase-env.js
secrets.js
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Safe Templates Whitelist (Always Track Templates)
!.env.example
!firebase-secrets.example.js
!.vercelignore
